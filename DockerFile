# =============================================================================
# Conda-forge / Bioconda based image (conda only - no mamba), pinned to R 4.4.3.
#
# The heavy R + Bioconductor stack (Seurat, fs, org.Hs.eg.db, MAST, ...) is
# installed as PRECOMPILED conda binaries from conda-forge + bioconda. This
# removes the source-compilation step that was failing on missing system
# libraries (e.g. `fs` needing libuv / uv.h).
#
# Only the packages that are NOT on conda (tidyestimate from CRAN, and the
# GitHub-only deconvolution backends) are still built from source - but now
# they compile inside the conda env, against already-installed binary deps,
# using conda's own compiler toolchain (the `conda run -n deconv` steps).
#
# If a later step ever reports another missing package, add the matching
# conda package (`r-<name>` from conda-forge, `bioconductor-<name>` from
# bioconda) to the `conda create` list below - that is the conda way to fix
# the "missing system lib" errors instead of apt-get + compile.
# =============================================================================
FROM condaforge/miniforge3:latest

# ---- Core stack into a dedicated env, from conda-forge + bioconda -----------
# Single solve so the R / Bioconductor versions stay consistent (R 4.4.3 ->
# Bioconductor 3.20). Installed in its own `deconv` env (not base) to keep
# conda's own Python untouched.
RUN conda create -y -n deconv --strict-channel-priority \
      -c conda-forge -c bioconda \
      "r-base=4.4.3" \
      r-optparse \
      r-jsonlite \
      r-data.table \
      r-matrix \
      r-seurat \
      r-ggplot2 \
      r-systemfonts \
      r-textshaping \
      r-ragg \
      r-svglite \
      r-dplyr \
      r-rcpp \
      r-rcpparmadillo \
      r-remotes \
      r-pak \
      r-biocmanager \
      bioconductor-org.hs.eg.db \
      bioconductor-biobase \
      bioconductor-singlecellexperiment \
      bioconductor-summarizedexperiment \
      bioconductor-sparsematrixstats \
      bioconductor-mast \
      c-compiler \
      cxx-compiler \
      fortran-compiler \
      make \
      git \
    && conda clean -afy

# Put the env on PATH so `Rscript` is the conda R at run time (no activation
# needed: conda R binaries use RPATH). Build steps below use `conda run -n
# deconv` so the compiler toolchain (CC/CXX/FC) is also activated.
ENV PATH=/opt/conda/envs/deconv/bin:${PATH}

# ---- Packages not available on conda ----------------------------------------
# tidyestimate: CRAN only, pure R (no system deps -> compiles cleanly).
RUN conda run --no-capture-output -n deconv R -q -e "install.packages('tidyestimate', repos='https://cloud.r-project.org')" \
 && conda run --no-capture-output -n deconv R -q -e "library(tidyestimate)"

# MCPcounter: GitHub only.
RUN conda run --no-capture-output -n deconv R -q -e "remotes::install_github('ebecht/MCPcounter', subdir='Source', upgrade='never', dependencies=FALSE)" \
 && conda run --no-capture-output -n deconv R -q -e "library(MCPcounter)"

# omnideconv's .onLoad installs a private miniconda under $HOME (for its Python
# methods, which this pipeline does not use) and FAILS if $HOME isn't writable --
# some hosts launch the container as a non-root user with HOME=/, so it tries to
# write //.local and dies. Pin that miniconda to a fixed, world-writable path
# independent of HOME/user, so .onLoad finds it at runtime no matter who (root or
# not) launches the container, and never tries to reinstall.
ENV HOME=/opt/omnideconv-home
ENV RETICULATE_MINICONDA_PATH=/opt/omnideconv-home/.local/share/r-miniconda
RUN mkdir -p /opt/omnideconv-home && chmod 777 /opt/omnideconv-home

# omnideconv core. upgrade=FALSE keeps the conda-provided binary deps instead
# of recompiling newer CRAN sources (which is what failed on systemfonts).
RUN conda run --no-capture-output -n deconv R -q -e "pak::pkg_install('omnideconv/omnideconv', upgrade = FALSE)" \
 && conda run --no-capture-output -n deconv R -q -e "library(omnideconv)" \
 && chmod -R 777 /opt/omnideconv-home

# Toolchain fixes for the GitHub-only backends compiled below:
#  - r-rcurl as a conda binary: source-compiling RCurl (a DWLS dependency)
#    fails to link `-lxml2` in the conda env. Installing it precompiled skips
#    that compile entirely.
#  - CXX11STD -> gnu++14: harmony and CDSeq declare `CXX_STD = CXX11`, but the
#    conda RcppArmadillo (15.x) requires a C++14 compiler. Overriding the C++11
#    standard makes those packages compile as C++14 (via Makevars.site).
RUN conda install -y -n deconv --strict-channel-priority -c conda-forge -c bioconda r-rcurl \
 && conda clean -afy \
 && printf 'CXX11STD = -std=gnu++14\n' >> /opt/conda/envs/deconv/lib/R/etc/Makevars.site

# Deconvolution backends (CDSeq compiles C++ via the conda toolchain).
RUN conda run --no-capture-output -n deconv R -q -e "remotes::install_github('omnideconv/DWLS',  upgrade='never', dependencies=NA, build_vignettes=FALSE)"
RUN conda run --no-capture-output -n deconv R -q -e "remotes::install_github('omnideconv/MuSiC', upgrade='never', dependencies=NA, build_vignettes=FALSE)"
RUN conda run --no-capture-output -n deconv R -q -e "remotes::install_github('omnideconv/CDSeq', upgrade='never', dependencies=NA, build_vignettes=FALSE)"

# BayesPrism (Danko-Lab) is pure R but pulls heavy Bioconductor deps (scran,
# BiocParallel) + NMF/snowfall/gplots; install those as conda binaries first,
# then the package itself from GitHub.
RUN conda install -y -n deconv --strict-channel-priority -c conda-forge -c bioconda \
      bioconductor-scran bioconductor-biocparallel r-nmf r-snowfall r-gplots \
 && conda clean -afy \
 && conda run --no-capture-output -n deconv R -q -e "remotes::install_github('Danko-Lab/BayesPrism', subdir='BayesPrism', upgrade='never', dependencies=NA, build_vignettes=FALSE)" \
 && conda run --no-capture-output -n deconv R -q -e "library(BayesPrism)"

# ---- Sanity check: every library the pipeline loads must import -------------
RUN conda run --no-capture-output -n deconv R -q -e "library(optparse); library(tidyestimate); library(MCPcounter); library(omnideconv); library(org.Hs.eg.db); library(Seurat); library(jsonlite); library(data.table); library(Matrix); library(ggplot2); cat('Docker image OK\\n')"

WORKDIR /app
COPY deconv_pipeline.R /app/deconv_pipeline.R
COPY preanalysis.R     /app/preanalysis.R

ENTRYPOINT ["Rscript", "/app/deconv_pipeline.R"]
